  "slots": {
    "title": {
      "type": "text",
      "sample": "Falcon Arabic Test",
      "maxLength": 29,
      "where": "text",
      "element": "text"
    },
    "subtitle": {
      "type": "text",
      "sample": "Falcon Arabic Test · falcon-h1r:7b",
      "maxLength": 55,
      "where": "text",
      "element": "text"
    },
    "user_text": {
      "type": "text",
      "sample": "Which orders from Gulf Steel are still unpaid?",
      "maxLength": 74,
      "where": "text",
      "element": "text"
    },
    "assistant_text": {
      "type": "text",
      "sample": "Three invoices are open, totalling AED 412,900. The oldest is 47 days past terms.",
      "maxLength": 130,
      "where": "text",
      "element": "text"
    },
    "placeholder": {
      "type": "text",
      "sample": "Message",
      "maxLength": 24,
      "where": "text",
      "element": "text"
    },
    "draft": {
      "type": "text",
      "sample": "Summarize the overdue invoices.",
      "maxLength": 50,
      "where": "text",
      "element": "text"
    },
    "filename": {
      "type": "text",
      "sample": "site-photo-4.heic",
      "maxLength": 28,
      "where": "text",
      "element": "text"
    },
    "error": {
      "type": "text",
      "sample": "Upload failed — file over 25 MB",
      "maxLength": 50,
      "where": "text",
      "element": "text"
    }
  }
}