{
  "component": "huf-ios-login-form",
  "note": "{{<slot>_initials}} placeholders are derived from the slot value (first letters of each word)",
  "slots": {
    "host": {
      "type": "text",
      "sample": "preview.invalid",
      "maxLength": 24,
      "where": "text",
      "element": "text"
    },
    "change": {
      "type": "text",
      "sample": "Change",
      "maxLength": 24,
      "where": "text",
      "element": "text"
    },
    "seg_password": {
