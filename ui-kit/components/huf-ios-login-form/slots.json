      "sample": "API key",
      "maxLength": 24,
      "where": "text",
      "element": "text"
    },
    "help_password": {
      "type": "text",
      "sample": "Use the username or email and password you sign in to Huf with.",
      "maxLength": 101,
      "where": "text",
      "element": "text"
    },
    "help_key": {
      "type": "text",
      "sample": "For service accounts or scripts. The key and secret are generated in Huf under your user's API Access settings.",
