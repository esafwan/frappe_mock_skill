{
  "component": "number-card",
  "slots": {
    "ellipsis": {
      "type": "text",
      "sample": "Open Work Orders",
      "maxLength": 32,
      "where": "text",
      "element": "span"
    },
    "pull_right": {
      "type": "text",
      "sample": "...",
      "maxLength": 20,
      "where": "text",
      "element": "number-card.link-1"
    },
    "dropdown_item": {
      "type": "text",
      "sample": "Refresh",
      "maxLength": 20,
      "where": "text",
      "element": "number-card.link-2"
    },
    "dropdown_item_2": {
      "type": "text",
      "sample": "Edit",
      "maxLength": 20,
      "where": "text",
      "element": "number-card.link-3"
    },
    "number": {
      "type": "number",
      "sample": "131",
      "maxLength": 20,
      "where": "text",
      "element": "div"
    },
    "percentage_stat_area": {
      "type": "text",
      "sample": "0 % since yesterday",
      "maxLength": 38,
      "where": "text",
      "element": "span"
    },
    "ellipsis_title": {
      "type": "text",
      "sample": "Open Work Orders",
      "maxLength": 32,
      "where": "attr:title",
      "element": "span"
    }
  }
}