    },
    "text_var_steel_6": {
      "type": "text",
      "sample": "Making something more permissive asks for confirmation in a system dialog.",
      "maxLength": 148,
      "where": "text",
      "element": "p"
    },
    "text_var_ink_14": {
      "type": "text",
      "sample": "Coding agent rules",
      "maxLength": 36,
      "where": "text",
      "element": "h3"
    },
    "block_4": {
      "type": "text",
      "sample": "Rules you saved when allowing a coding agent (Claude Code, Codex) to run something without asking again. Each rule matches one exact kind of request, never anything broader. You can revoke any rule here, turn automatic answers off entirely, and review the last 200 times a rule answered for you.",
      "maxLength": 590,
      "where": "text",
      "element": "span"
    },
    "text_var_ink_15": {
      "type": "text",
      "sample": "Allow Huf to auto-answer saved rules",
      "maxLength": 72,
      "where": "text",
      "element": "label"
    },
    "block_5": {
      "type": "text",
      "sample": "When on, a request that matches one of the rules below is allowed without showing a card, and the chat shows that a rule did it. When off, every request asks you, even if a rule exists. The change applies right away, including to requests that are already waiting.",
      "maxLength": 528,
      "where": "text",
      "element": "span"
    },
    "text_var_signal_ink_2": {
      "type": "text",
      "sample": "On",
      "maxLength": 20,
      "where": "text",
      "element": "span"
    },
    "text_var_ink_16": {
      "type": "text",
      "sample": "Saved rules",
      "maxLength": 22,
      "where": "text",
      "element": "h3"
    },
    "text_var_steel_7": {
      "type": "text",
      "sample": "No saved rules. When you choose Allow for this session or Always allow on an approval card, the rule appears here.",
      "maxLength": 228,
      "where": "text",
      "element": "p"
    },
    "text_var_ink_17": {
      "type": "text",
      "sample": "Recent automatic answers",
      "maxLength": 48,
      "where": "text",
      "element": "h3"
    },
    "text_var_steel_8": {
      "type": "text",
      "sample": "No automatic answers yet.",
      "maxLength": 50,
      "where": "text",
      "element": "p"
    },
    "text_var_ink_18": {
      "type": "text",
      "sample": "Remote control",
      "maxLength": 28,
      "where": "text",
      "element": "h3"
    },
    "block_6": {
      "type": "text",
      "sample": "Lets your Huf web and mobile sessions use this computer's tools. It is off by default and worth leaving off unless you actually work from another device.",
      "maxLength": 306,
      "where": "text",
      "element": "span"
    },
    "text_var_steel_9": {
      "type": "text",
      "sample": "Off",
      "maxLength": 20,
      "where": "text",
      "element": "span"
    },
    "text_var_ink_19": {
      "type": "text",
      "sample": "Allow web and mobile sessions to control this computer",
      "maxLength": 108,
      "where": "text",
      "element": "label"
    },
    "block_7": {
      "type": "text",
      "sample": "Turn it on to let your Huf web and mobile sessions use this computer, each workspace under its own approval mode. A system dialog asks you to confirm.",
      "maxLength": 300,
      "where": "text",
      "element": "span"
    },
    "text_var_ink_20": {
      "type": "text",
      "sample": "Risk",
      "maxLength": 20,
      "where": "text",
      "element": "span"
    },
    "text_var_ink_21": {
      "type": "text",
      "sample": ".",
      "maxLength": 20,
      "where": "text",
      "element": "span"
    },
    "text_var_steel_10": {
      "type": "text",
      "sample": "While on, remote sessions use each workspace's own permission mode with no extra prompt and can change that mode, including to Full. Anyone who controls your signed-in Huf session can therefore act here. Every remote call and mode change appears in Activity.",
      "maxLength": 516,
      "where": "text",
      "element": "p"
    },
    "text_var_ink_22": {
      "type": "text",
      "sample": "Agents excluded from remote control",
      "maxLength": 70,
      "where": "text",
      "element": "span"
    },
    "start_0_2": {
      "type": "text",
      "sample": "An excluded agent is refused by remote sessions even while the switch is on. Use it to keep specific agents off this computer while the others stay allowed.",
      "maxLength": 312,
      "where": "text",
      "element": "span"
    },
    "text_var_steel_11": {
      "type": "text",
      "sample": "None. Every agent follows the switch above.",
      "maxLength": 86,
      "where": "text",
      "element": "div"
    },
    "text_xs_17": {
      "type": "text",
      "sample": "Exclude",
      "maxLength": 20,
      "where": "text",
      "element": "huf-desktop-settings-agents.button-31"
    },
    "font_medium": {
      "type": "text",
      "sample": "Advanced agent settings",
      "maxLength": 46,
      "where": "text",
      "element": "span"
    },
    "text_var_steel_12": {
      "type": "text",
      "sample": "Rarely needed. Install scripts can run code that nobody reviewed.",
      "maxLength": 130,
      "where": "text",
      "element": "span"
    },
    "text_var_ink_23": {
      "type": "text",
      "sample": "Package install scripts",
      "maxLength": 46,
      "where": "text",
      "element": "h3"
    },
    "block_8": {
      "type": "text",
      "sample": "Every package install an agent runs is asked about first and never remembered. This one switch covers a separate question: whether the install scripts that some packages bring may run.",
      "maxLength": 368,
      "where": "text",
      "element": "span"
    },
    "text_var_ink_24": {
      "type": "text",
      "sample": "Let installed packages run their install scripts (supplier-ops)",
      "maxLength": 126,
      "where": "text",
      "element": "label"
    },
    "block_9": {
      "type": "text",
      "sample": "Some packages run a script when installed. Off, they do not. Turn it on only if a project you trust needs them. It applies to the open workspace only.",
      "maxLength": 300,
      "where": "text",
      "element": "span"
    },
    "text_var_ink_25": {
      "type": "text",
      "sample": "Risk",
      "maxLength": 20,
      "where": "text",
      "element": "span"
    },
    "text_var_ink_26": {
      "type": "text",
      "sample": ".",
      "maxLength": 20,
      "where": "text",
      "element": "span"
    },
    "text_var_steel_13": {
      "type": "text",
      "sample": "Off by default. Scripts still run inside the sandbox, but you do not see them before they run.",
      "maxLength": 188,
      "where": "text",
      "element": "p"
    },
