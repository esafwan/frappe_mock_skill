    "text_var_ink_3": {
      "type": "text",
      "sample": "Agents and permissions",
      "maxLength": 44,
      "where": "text",
      "element": "h3"
    },
    "text_var_steel": {
      "type": "text",
      "sample": "What agents may do on this computer.",
      "maxLength": 72,
      "where": "text",
      "element": "span"
    },
    "start_0": {
      "type": "text",
      "sample": "What agents may do on this computer. Start with the approval mode in the chat composer; use this page for per-agent limits and for remote control. Everything here applies to the workspace you have open.",
      "maxLength": 404,
      "where": "text",
      "element": "span"
    },
    "md_block": {
      "type": "text",
      "sample": "Close",
      "maxLength": 20,
      "where": "text",
      "element": "huf-desktop-settings-agents.button-11"
    },
    "text_var_ink_4": {
      "type": "text",
      "sample": "Approval mode",
      "maxLength": 26,
      "where": "text",
      "element": "h3"
    },
    "block": {
      "type": "text",
      "sample": "How agent actions are approved is set per workspace, from the Permissions chip in the chat composer. It decides what runs freely and what asks you first.",
      "maxLength": 306,
      "where": "text",
      "element": "span"
    },
    "block_2": {
      "type": "text",
      "sample": "Change the mode from the Permissions chip in the chat composer. Each workspace keeps its own mode, and Ask every time is the starting point for a new one.",
      "maxLength": 308,
      "where": "text",
      "element": "span"
    },
    "text_var_ink_5": {
      "type": "text",
      "sample": "Ask every time",
      "maxLength": 28,
      "where": "text",
      "element": "dt"
    },
    "text_var_steel_2": {
      "type": "text",
      "sample": "Every write, delete and command asks for approval, every time. Reads run freely.",
      "maxLength": 160,
      "where": "text",
      "element": "dd"
    },
    "text_var_ink_6": {
      "type": "text",
      "sample": "Auto",
      "maxLength": 20,
      "where": "text",
      "element": "dt"
    },
    "text_var_steel_3": {
      "type": "text",
      "sample": "Reads run freely. Writes and commands ask; you can allow a kind of action for the rest of the run. Deletes and protected paths always ask.",
      "maxLength": 276,
      "where": "text",
      "element": "dd"
    },
    "text_var_ink_7": {
      "type": "text",
      "sample": "Sandboxed",
      "maxLength": 20,
      "where": "text",
      "element": "dt"
    },
    "text_var_steel_4": {
      "type": "text",
      "sample": "Reads and normal writes inside the workspace run freely. Commands run confined to the workspace and ask first. Sensitive or protected paths ask.",
      "maxLength": 288,
      "where": "text",
      "element": "dd"
    },
    "text_var_ink_8": {
      "type": "text",
      "sample": "Full access",
      "maxLength": 22,
      "where": "text",
      "element": "dt"
    },
    "text_var_steel_5": {
      "type": "text",
      "sample": "No gating. Every operation runs immediately, commands run unconfined.",
      "maxLength": 138,
      "where": "text",
      "element": "dd"
    },
    "text_var_ink_9": {
      "type": "text",
      "sample": "Limits per agent",
      "maxLength": 32,
      "where": "text",
      "element": "h3"
    },
    "block_3": {
      "type": "text",
      "sample": "Turn a kind of access off, or force a prompt, for one agent or for every agent in this workspace. Limits can only tighten what the approval mode allows; the Huf server can also set a ceiling for an agent, and the stricter of the two applies.",
      "maxLength": 482,
      "where": "text",
      "element": "span"
    },
    "text_var_ink_10": {
      "type": "text",
      "sample": "off",
      "maxLength": 20,
      "where": "text",
      "element": "dt"
    },
    "sm_gap_2": {
      "type": "text",
      "sample": "The agent is refused, whatever the approval mode says.",
      "maxLength": 108,
      "where": "text",
      "element": "dd"
    },
    "text_var_ink_11": {
      "type": "text",
      "sample": "ask",
      "maxLength": 20,
      "where": "text",
      "element": "dt"
    },
    "sm_gap_2_2": {
      "type": "text",
      "sample": "The agent always prompts you, even where the mode would let it run.",
      "maxLength": 134,
      "where": "text",
      "element": "dd"
    },
    "text_var_ink_12": {
      "type": "text",
      "sample": "allowed",
      "maxLength": 20,
      "where": "text",
      "element": "dt"
    },
    "sm_gap_2_3": {
      "type": "text",
      "sample": "No extra limit; the workspace approval mode decides.",
      "maxLength": 104,
      "where": "text",
      "element": "dd"
    },
    "space_y_1": {
      "type": "text",
      "sample": "Areas: cli (commands), files, skills, local_mcp (local MCP servers), browser, installs (package installs) and processes (long-running background commands).",
      "maxLength": 310,
      "where": "text",
      "element": "div"
    },
    "text_var_signal_ink": {
      "type": "text",
      "sample": "5 limits",
      "maxLength": 20,
      "where": "text",
      "element": "span"
    },
    "text_var_ink_13": {
      "type": "text",
      "sample": "For workspace supplier-ops. Off refuses, Ask always prompts, Allowed follows the workspace permission mode. The most restrictive setting wins.",
      "maxLength": 284,
      "where": "text",
      "element": "p"
    },
