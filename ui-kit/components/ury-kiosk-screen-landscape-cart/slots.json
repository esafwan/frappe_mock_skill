      "sample": "Your Cart",
      "maxLength": 24,
      "where": "text",
      "element": "text"
    },
    "c1_name": {
      "type": "text",
      "sample": "Latte",
      "maxLength": 24,
      "where": "text",
      "element": "text"
    },
    "c1_qty": {
      "type": "text",
      "sample": "1",
      "maxLength": 24,
      "where": "text",
      "element": "text"
