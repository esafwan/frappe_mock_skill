      "sample": "Espresso",
      "maxLength": 24,
      "where": "text",
      "element": "text"
    },
    "l1_qty": {
      "type": "text",
      "sample": "1",
      "maxLength": 24,
      "where": "text",
      "element": "text"
    },
    "l2_name": {
      "type": "text",
      "sample": "Cappuccino",
      "maxLength": 24,
      "where": "text",
      "element": "text"
    },
    "l2_qty": {
      "type": "text",
      "sample": "2",
      "maxLength": 24,
      "where": "text",
      "element": "text"
    },
    "note_label": {
      "type": "text",
      "sample": "Note:",
      "maxLength": 24,
      "where": "text",
