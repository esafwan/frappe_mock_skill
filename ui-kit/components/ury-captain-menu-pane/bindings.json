  "component": "ury-captain-menu-pane",
  "note": "slot -> menu expression; applied by tools/render.mjs when --menu is given. items[i] wraps around the menu length.",
  "bind": {
    "name_1": "menu.items[0].name",
    "course_1": "menu.items[0].category",
    "price_1": "menu.items[0].price",
    "image_1": "menu.items[0].image",
    "name_2": "menu.items[1].name",
    "course_2": "menu.items[1].category",
    "price_2": "menu.items[1].price",
    "image_2": "menu.items[1].image",
    "name_3": "menu.items[2].name",
    "course_3": "menu.items[2].category",
    "price_3": "menu.items[2].price",
    "image_3": "menu.items[2].image",
    "name_4": "menu.items[3].name",
    "course_4": "menu.items[3].category",
    "price_4": "menu.items[3].price",
    "image_4": "menu.items[3].image",
    "chip_2": "menu.categories[0].name",
    "chip_3": "menu.categories[1].name",
    "chip_4": "menu.categories[2].name",
    "chip_5": "menu.categories[3].name"
  }
