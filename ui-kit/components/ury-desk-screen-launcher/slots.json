{
  "component": "ury-desk-screen-launcher",
  "note": "{{<slot>_initials}} placeholders are derived from the slot value (first letters of each word)",
  "slots": {
    "nav_user_name": {
      "type": "text",
      "sample": "Administrator",
      "maxLength": 24,
      "where": "text",
      "element": "text"
    },
    "nav_search": {
      "type": "text",
      "sample": "Search",
      "maxLength": 24,
      "where": "text",
      "element": "text"
    },
    "nav_navbar_shortcut": {
      "type": "text",
      "sample": "Ctrl+K",
      "maxLength": 24,
      "where": "text",
      "element": "text"
    },
    "nav_notif_count": {
      "type": "text",
      "sample": "6",
      "maxLength": 24,
      "where": "text",
      "element": "text"
    },
    "ln_logo_erp": {
      "type": "image",
      "sample": "data:image/svg+xml;base64,",
      "maxLength": 1245,
      "where": "text",
      "element": "text"
    },
    "ln_title_erp": {
      "type": "text",
      "sample": "ERPNext",
      "maxLength": 24,
      "where": "text",
      "element": "text"
    },
    "ln_logo_ury": {
      "type": "image",
      "sample": "data:image/png;base64,",
      "maxLength": 9668,
      "where": "text",
      "element": "text"
    },
    "ln_title_ury": {
      "type": "text",
      "sample": "URY",
      "maxLength": 24,
      "where": "text",
      "element": "text"
    },
    "ln_sub": {
      "type": "text",
      "sample": "Open in Desk",
      "maxLength": 24,
      "where": "text",
      "element": "text"
    },
    "ln_logo_huf": {
      "type": "image",
      "sample": "data:image/png;base64,",
      "maxLength": 18954,
      "where": "text",
      "element": "text"
    },
    "ln_title_huf": {
      "type": "text",
      "sample": "Huf",
      "maxLength": 24,
      "where": "text",
      "element": "text"
    }
