{
 "id": "la-retail-festival",
 "system": "loyal-arrow-desk",
 "viewport": {
  "w": 1440,
  "h": 900
 },
 "reference": "rs-p1b-festival/after_festival-cohort_1440_light.png",
 "data": "loyal-arrow/data/retail-festival.json",
 "shell": "la-shell (section-expanded, Retail active)",
 "states": {
  "hidden-days": "retail-festival.html (matches reference; 1 hidden day each year)",
  "populated": "retail-festival.populated.html (no hidden days)",
  "zero": "retail-festival.zero.html (0 bills this year)",
  "empty": "retail-festival.empty.html (no data either year)",
  "no-lead": "retail-festival.no-lead.html (days before unchecked)",
  "festival-changed": "retail-festival.festival-diwali.html / .festival-eid.html",
  "race-half": "line race mid-way via --la-race-this/--la-race-last on chart"
 },
 "variants": [
  "retail-festival.html",
  "retail-festival.dark.html",
  "retail-festival.ar-AED.html",
  "retail-festival.ar-AED.dark.html",
  "retail-festival.en-INR.html",
