  "w": 1440,
  "h": 900
 },
 "reference": "rs-p1a-heatmap/after_heatmap_1440_light.png",
 "data": "loyal-arrow/data/retail-heatmap.json",
 "shell": "la-shell (section-expanded, Retail active)",
